@model EventEaseBookingSystem.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<style>
    body {
        background: linear-gradient(to bottom right, #e6f0ff, #f8f9fa);
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #333;
    }

    .event-page {
        max-width: 1000px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .event-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .event-header {
        background: linear-gradient(to right, #eef6ff, #ffffff);
        border-bottom: 1px solid #dce8f5;
        padding: 30px 35px;
    }

    .event-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background-color: #dceeff;
        color: #0078d7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .event-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
        color: #343a40;
    }

    .event-header p {
        margin-bottom: 0;
        color: #6c757d;
    }

    .event-content {
        padding: 30px 35px 35px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #005a9e;
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        border: 1px solid #d5deea;
        border-radius: 8px;
        padding: 11px 14px;
        min-height: 45px;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.10);
        }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .field-description {
        font-size: 13px;
        color: #6c757d;
        margin-top: 6px;
    }

    .date-panel {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }

    .venue-panel {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        margin-top: 25px;
    }

    .image-panel {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        margin-top: 25px;
    }

    .image-upload-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #dceeff;
        color: #0078d7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        margin-bottom: 12px;
    }

    .image-note {
        background-color: #eef6ff;
        border-left: 4px solid #0078d7;
        border-radius: 6px;
        padding: 12px 15px;
        margin-top: 15px;
        font-size: 13px;
        color: #495057;
    }

    .validation-summary {
        background: #fff1f1;
        border-left: 4px solid #dc3545;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 25px;
        color: #9b2c2c;
    }

        .validation-summary ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    .text-danger {
        font-size: 13px;
    }

    .button-section {
        padding: 25px 35px;
        background-color: #fafbfc;
        border-top: 1px solid #edf0f4;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

        .button-section .btn {
            min-width: 130px;
            padding: 10px 18px;
            font-weight: 600;
            border-radius: 8px;
        }

    @@media (max-width: 768px) {

        .event-page {
            margin: 25px auto;
        }

        .event-header,
        .event-content,
        .button-section {
            padding: 25px 20px;
        }

        .button-section {
            flex-direction: column;
        }

            .button-section .btn {
                width: 100%;
            }

        .date-panel {
            margin-top: 20px;
        }
    }
</style>

<div class="event-page">

    <div class="event-card">

        <!-- Page Header -->
        <div class="event-header">

            <div class="event-icon">
                +
            </div>

            <h1>Create Event</h1>

            <p>
                Add a new event, upload an image, and assign it to a venue.
            </p>

        </div>

        <!-- Event Form -->
        <!-- multipart/form-data is required for Azure image uploads -->
        <form asp-controller="Events"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div class="event-content">

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="validation-summary">
                    </div>
                }

                <!-- Event Information -->
                <div class="section-title">
                    Event Information
                </div>

                <!-- Event Name -->
                <div class="mb-4">

                    <label asp-for="EventName"
                           class="form-label">
                        Event Name
                    </label>

                    <input asp-for="EventName"
                           class="form-control"
                           placeholder="Enter the event name" />

                    <span asp-validation-for="EventName"
                          class="text-danger">
                    </span>

                </div>

                <!-- Description -->
                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="Enter a description of the event"></textarea>

                    <div class="field-description">
                        Provide a brief description to help users understand the event.
                    </div>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <!-- Event Image -->
                <div class="image-panel">

                    <div class="image-upload-icon">
                        <i class="bi bi-image"></i>
                    </div>

                    <div class="section-title mb-3">
                        Event Image
                    </div>

                    <label for="imageFile"
                           class="form-label">
                        Upload Event Image
                    </label>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.gif,.webp" />

                    <div class="field-description">
                        Upload an image representing this event.
                    </div>

                    <div class="image-note">
                        <i class="bi bi-cloud-arrow-up me-1"></i>
                        The selected image will be securely uploaded to Azure Blob Storage.
                        JPG, PNG, GIF, and WEBP files up to 5 MB are supported.
                    </div>

                    <span class="text-danger"
                          data-valmsg-for="imageFile"
                          data-valmsg-replace="true">
                    </span>

                </div>

                <!-- Dates -->
                <div class="section-title mt-4">
                    Event Schedule
                </div>

                <div class="row g-4">

                    <!-- Start Date -->
                    <div class="col-12 col-md-6">

                        <div class="date-panel">

                            <label asp-for="StartDate"
                                   class="form-label">
                                Start Date and Time
                            </label>

                            <input asp-for="StartDate"
                                   class="form-control"
                                   type="datetime-local" />

                            <div class="field-description">
                                Select when the event begins.
                            </div>

                            <span asp-validation-for="StartDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- End Date -->
                    <div class="col-12 col-md-6">

                        <div class="date-panel">

                            <label asp-for="EndDate"
                                   class="form-label">
                                End Date and Time
                            </label>

                            <input asp-for="EndDate"
                                   class="form-control"
                                   type="datetime-local" />

                            <div class="field-description">
                                Select when the event ends.
                            </div>

                            <span asp-validation-for="EndDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <!-- Venue -->
                <div class="venue-panel">

                    <div class="section-title mb-3">
                        Venue Assignment
                    </div>

                    <label asp-for="VenueId"
                           class="form-label">
                        Venue
                    </label>

                    <select asp-for="VenueId"
                            class="form-select"
                            asp-items="@(ViewData["VenueId"] as SelectList)">

                        <option value="">
                            Select a venue
                        </option>

                    </select>

                    <div class="field-description">
                        Choose the venue where this event will take place.
                    </div>

                    <span asp-validation-for="VenueId"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- Buttons -->
            <div class="button-section">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-calendar-plus me-1"></i>
                    Create Event
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}