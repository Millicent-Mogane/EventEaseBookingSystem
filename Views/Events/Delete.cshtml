@model EventEaseBookingSystem.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<style>
    body {
        background: linear-gradient(to bottom right, #e6f0ff, #f8f9fa);
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #333;
    }

    .delete-page {
        max-width: 1000px;
        margin: 50px auto;
        padding: 0 20px;
    }

    .delete-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .delete-header {
        background: linear-gradient(to right, #fff5f5, #ffffff);
        border-bottom: 1px solid #f1d5d5;
        padding: 30px 35px;
    }

    .delete-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background-color: #f8d7da;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .delete-header h1 {
        font-weight: 700;
        margin-bottom: 8px;
        color: #343a40;
    }

    .delete-header p {
        margin-bottom: 0;
        color: #6c757d;
    }

    .warning-box {
        margin: 25px 35px 0;
        padding: 16px 20px;
        border-radius: 10px;
        background-color: #fff3cd;
        border: 1px solid #ffe69c;
        color: #664d03;
    }

        .warning-box strong {
            color: #664d03;
        }

    .event-content {
        padding: 30px 35px 35px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #005a9e;
        margin-bottom: 20px;
    }

    .information-row {
        padding: 14px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .information-row:last-child {
            border-bottom: none;
        }

    .information-label {
        font-weight: 600;
        color: #495057;
    }

    .information-value {
        color: #333;
    }

    .schedule-panel {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }

    .venue-panel {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        margin-top: 25px;
    }

    .description-box {
        background-color: #f8faff;
        border: 1px solid #e3eaf5;
        border-radius: 12px;
        padding: 20px;
        margin-top: 25px;
    }

    .delete-actions {
        padding: 25px 35px;
        background-color: #fafbfc;
        border-top: 1px solid #edf0f4;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

        .delete-actions .btn {
            min-width: 130px;
            padding: 10px 18px;
            font-weight: 600;
            border-radius: 8px;
        }

        .delete-actions .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }

            .delete-actions .btn-danger:hover {
                background-color: #bb2d3b;
                border-color: #b02a37;
            }

    .validation-alert {
        margin: 25px 35px 0;
    }

    @@media (max-width: 768px) {

        .delete-page {
            margin: 25px auto;
        }

        .delete-header,
        .event-content,
        .delete-actions {
            padding: 25px 20px;
        }

        .warning-box,
        .validation-alert {
            margin-left: 20px;
            margin-right: 20px;
        }

        .delete-actions {
            flex-direction: column;
        }

            .delete-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="delete-page">

    <div class="delete-card">

        <!-- Page Header -->
        <div class="delete-header">

            <div class="delete-icon">
                !
            </div>

            <h1>Delete Event</h1>

            <p>
                Please review the event information before confirming deletion.
            </p>

        </div>

        <!-- Warning -->
        <div class="warning-box">

            <strong>Are you sure you want to delete this event?</strong>

            <div class="mt-1">
                This action permanently removes the event from the system.
                If the event has an existing booking, the deletion will be blocked.
            </div>

        </div>

        <!-- Validation Error -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show validation-alert"
                 role="alert"
                 id="errorAlert">

                <strong>Unable to complete the request.</strong>

                <div class="mt-1">

                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                        {
                            <div>
                                @error.ErrorMessage
                            </div>
                        }
                    }

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }

        <!-- Event Information -->
        <div class="event-content">

            <div class="section-title">
                Event Information
            </div>

            <!-- Event Name -->
            <div class="information-row row">

                <div class="col-sm-4 information-label">
                    Event Name
                </div>

                <div class="col-sm-8 information-value">
                    @Model.EventName
                </div>

            </div>

            <!-- Description -->
            <div class="description-box">

                <div class="section-title mb-2">
                    Description
                </div>

                <div class="information-value">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "No description provided"
                                        : Model.Description)
                </div>

            </div>

            <!-- Schedule -->
            <div class="section-title mt-4">
                Event Schedule
            </div>

            <div class="row g-4">

                <!-- Start -->
                <div class="col-12 col-md-6">

                    <div class="schedule-panel">

                        <div class="information-label mb-2">
                            Start Date and Time
                        </div>

                        <div class="information-value">
                            @Model.StartDate.ToString("dd MMMM yyyy, HH:mm")
                        </div>

                    </div>

                </div>

                <!-- End -->
                <div class="col-12 col-md-6">

                    <div class="schedule-panel">

                        <div class="information-label mb-2">
                            End Date and Time
                        </div>

                        <div class="information-value">
                            @Model.EndDate.ToString("dd MMMM yyyy, HH:mm")
                        </div>

                    </div>

                </div>

            </div>

            <!-- Venue -->
            <div class="venue-panel">

                <div class="section-title mb-2">
                    Venue Assignment
                </div>

                <div class="information-row row">

                    <div class="col-sm-4 information-label">
                        Venue
                    </div>

                    <div class="col-sm-8 information-value">
                        @(Model.Venue?.VenueName ?? "No venue assigned")
                    </div>

                </div>

                @if (Model.Venue != null)
                {
                    <div class="information-row row">

                        <div class="col-sm-4 information-label">
                            Location
                        </div>

                        <div class="col-sm-8 information-value">
                            @Model.Venue.Location
                        </div>

                    </div>
                }

            </div>

        </div>

        <!-- Delete Actions -->
        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="EventId" />

            @Html.AntiForgeryToken()

            <div class="delete-actions">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Event
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            var errorAlert = document.getElementById('errorAlert');

            if (errorAlert) {

                setTimeout(function () {

                    errorAlert.style.transition =
                        "opacity 0.5s ease, transform 0.5s ease";

                    errorAlert.style.opacity = "0";
                    errorAlert.style.transform = "translateY(-20px)";

                    setTimeout(function () {

                        if (errorAlert) {
                            errorAlert.remove();
                        }

                    }, 500);

                }, 5000);
            }

        });

    </script>

}