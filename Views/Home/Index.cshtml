@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        background-image: url('/images/banner.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100vh;
        margin: 0;
        color: white; /* ensures text is readable */
    }

    .overlay {
        background-color: rgba(0, 0, 0, 0.25); /* lighter semi-transparent layer */
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .btn-lg {
        transition: all 0.3s ease;
    }

        .btn-lg:hover {
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.8); /* glow effect */
            transform: scale(1.05); /* slight zoom */
        }
</style>

<div class="overlay">
    <h1 class="display-4">Welcome to EventEase Booking System</h1>
    <p class="lead">Manage venues, events, and bookings seamlessly — all in one place.</p>

    <div class="mt-4">
        <a class="btn btn-primary btn-lg mx-2" asp-controller="Events" asp-action="Index">View Events</a>
        <a class="btn btn-success btn-lg mx-2" asp-controller="Venues" asp-action="Index">Browse Venues</a>
        <a class="btn btn-info btn-lg mx-2" asp-controller="Bookings" asp-action="Index">Manage Bookings</a>
    </div>
</div>
