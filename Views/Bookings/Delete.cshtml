@model EventEaseBookingSystem.Models.Booking

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delete Booking";
}

<style>
    .booking-page {
        background: linear-gradient(135deg, #eaf4ff, #f8fbff);
        min-height: calc(100vh - 120px);
        padding: 50px 20px;
    }

    .booking-card {
        max-width: 900px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.10);
        overflow: hidden;
        border: 1px solid #e1eaf4;
    }

    .booking-header {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        padding: 30px 35px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .booking-icon {
        width: 58px;
        height: 58px;
        background: rgba(255, 255, 255, 0.18);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .booking-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 600;
    }

    .booking-header p {
        margin: 6px 0 0;
        opacity: 0.9;
        font-size: 15px;
    }

    .booking-content {
        padding: 35px;
    }

    .warning-panel {
        background: #fff4f4;
        border: 1px solid #f1b5b5;
        border-left: 5px solid #dc3545;
        border-radius: 10px;
        padding: 20px 22px;
        margin-bottom: 30px;
    }

        .warning-panel h3 {
            color: #b02a37;
            font-size: 20px;
            margin: 0 0 8px;
            font-weight: 600;
        }

        .warning-panel p {
            color: #6c2b2f;
            margin: 0;
            line-height: 1.6;
        }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #0d6efd;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
    }

        .section-title i {
            font-size: 21px;
        }

    .booking-info {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        border-bottom: 1px solid #e9ecef;
        min-height: 60px;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        background: #f5f9fd;
        padding: 18px;
        font-weight: 600;
        color: #495057;
    }

    .info-value {
        padding: 18px;
        color: #212529;
    }

        .info-value strong {
            display: block;
            font-size: 16px;
            color: #212529;
            margin-bottom: 4px;
        }

    .secondary-text {
        display: block;
        color: #6c757d;
        font-size: 14px;
        margin-top: 3px;
    }

    .booking-id {
        display: inline-block;
        background: #e7f1ff;
        color: #0d6efd;
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-confirmed {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-pending {
        background: #fff3cd;
        color: #664d03;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #842029;
    }

    .status-default {
        background: #e9ecef;
        color: #495057;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 5px;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-delete:hover {
            background: #bb2d3b;
            color: white;
        }

    .btn-back {
        background: #ffffff;
        color: #0d6efd;
        border: 1px solid #0d6efd;
        border-radius: 8px;
        padding: 11px 22px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-back:hover {
            background: #0d6efd;
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 650px) {
        .booking-page {
            padding: 25px 12px;
        }

        .booking-header {
            padding: 25px 20px;
        }

            .booking-header h1 {
                font-size: 25px;
            }

        .booking-content {
            padding: 20px;
        }

        .info-row {
            grid-template-columns: 1fr;
        }

        .info-label {
            padding: 12px 15px;
        }

        .info-value {
            padding: 15px;
        }

        .action-buttons {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-delete,
        .btn-back {
            text-align: center;
            width: 100%;
        }
    }
</style>

<div class="booking-page">
    <div class="booking-card">

        <div class="booking-header">
            <div class="booking-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <div>
                <h1>Delete Booking</h1>
                <p>Review the booking before permanently removing it.</p>
            </div>
        </div>

        <div class="booking-content">

            <div class="warning-panel">
                <h3>Are you sure you want to delete this booking?</h3>
                <p>
                    This action permanently removes the booking from the system.
                    Please review the booking information below before continuing.
                </p>
            </div>

            <div class="section-title">
                <i class="bi bi-calendar-check"></i>
                Booking Information
            </div>

            <div class="booking-info">

                <div class="info-row">
                    <div class="info-label">Booking ID</div>
                    <div class="info-value">
                        <span class="booking-id">#@Model.BookingId</span>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Booking Date</div>
                    <div class="info-value">
                        @Model.BookingDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Event</div>
                    <div class="info-value">

                        @if (Model.Event != null)
                        {
                            <strong>@Model.Event.EventName</strong>

                            <span class="secondary-text">
                                @Model.Event.StartDate.ToString("dd MMMM yyyy, HH:mm")
                                -
                                @Model.Event.EndDate.ToString("dd MMMM yyyy, HH:mm")
                            </span>
                        }
                        else
                        {
                            <span>Event information unavailable</span>
                        }

                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Venue</div>
                    <div class="info-value">

                        @if (Model.Venue != null)
                        {
                            <strong>@Model.Venue.VenueName</strong>

                            <span class="secondary-text">
                                @Model.Venue.Location
                            </span>
                        }
                        else
                        {
                            <span>Venue information unavailable</span>
                        }

                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Status</div>

                    <div class="info-value">

                        @if (Model.Status == "Confirmed")
                        {
                            <span class="status-badge status-confirmed">
                                Confirmed
                            </span>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <span class="status-badge status-pending">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <span class="status-badge status-cancelled">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-default">
                                @Model.Status
                            </span>
                        }

                    </div>
                </div>

            </div>

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="BookingId" />

                <div class="action-buttons">

                    <button type="submit" class="btn-delete">
                        <i class="bi bi-trash3"></i>
                        Delete Booking
                    </button>

                    <a asp-action="Index" class="btn-back">
                        <i class="bi bi-arrow-left"></i>
                        Back to Bookings
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>