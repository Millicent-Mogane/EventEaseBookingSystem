@model EventEaseBookingSystem.Models.Venue

@{
    ViewData["Title"] = "Create New Venue";
}

<style>
    body {
        background: linear-gradient(to bottom right, #e6f0ff, #f8f9fa);
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #333;
    }

    .venue-page {
        padding: 45px 15px 60px;
    }

    .venue-card {
        max-width: 950px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .venue-header {
        padding: 30px 40px 25px;
        border-bottom: 1px solid #e9ecef;
        background: linear-gradient(to right, #ffffff, #f7fbff);
    }

        .venue-header h1 {
            margin: 0 0 6px;
            font-size: 2rem;
            font-weight: 700;
            color: #1f2937;
        }

        .venue-header p {
            margin: 0;
            color: #6c757d;
            font-size: 1rem;
        }

    .venue-header-icon {
        color: #0078d7;
        margin-right: 9px;
    }

    .venue-form {
        padding: 35px 40px 40px;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 22px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e6f0ff;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 7px;
    }

        .form-label i {
            color: #0078d7;
            margin-right: 6px;
        }

    .form-control {
        border: 1px solid #ced4da;
        border-radius: 7px;
        padding: 10px 12px;
        min-height: 44px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #0078d7;
            box-shadow: 0 0 0 0.2rem rgba(0, 120, 215, 0.12);
        }

    .image-section {
        margin-top: 10px;
        padding: 25px;
        border: 2px dashed #c8dff5;
        border-radius: 12px;
        background: #f8fbff;
        text-align: center;
    }

    .image-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #e6f0ff;
        color: #0078d7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .image-section h5 {
        margin-bottom: 6px;
        font-weight: 700;
        color: #374151;
    }

    .image-section p {
        margin-bottom: 18px;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .image-section .form-control {
        max-width: 650px;
        margin: 0 auto;
        background: #ffffff;
        text-align: left;
    }

    .field-help {
        display: block;
        margin-top: 6px;
        color: #6c757d;
        font-size: 0.85rem;
    }

    .validation-summary {
        margin-bottom: 25px;
    }

    .button-section {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 32px;
        padding-top: 25px;
        border-top: 1px solid #e9ecef;
    }

    .btn-create {
        background-color: #198754;
        border-color: #198754;
        color: #ffffff;
        padding: 10px 22px;
        border-radius: 7px;
        font-weight: 600;
    }

        .btn-create:hover {
            background-color: #157347;
            border-color: #146c43;
            color: #ffffff;
        }

    .btn-cancel {
        background-color: #ffffff;
        border: 1px solid #6c757d;
        color: #495057;
        padding: 10px 22px;
        border-radius: 7px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background-color: #f1f3f5;
            color: #212529;
        }

    .required-note {
        margin-top: 18px;
        color: #6c757d;
        font-size: 0.85rem;
    }

    /* Responsive layout */
    @@media (max-width: 768px) {

        .venue-page {
            padding: 25px 10px 40px;
        }

        .venue-header {
            padding: 25px;
        }

        .venue-form {
            padding: 25px;
        }

        .venue-header h1 {
            font-size: 1.7rem;
        }

        .button-section {
            justify-content: stretch;
            flex-direction: column-reverse;
        }

            .button-section .btn {
                width: 100%;
                text-align: center;
            }
    }
</style>


<div class="venue-page">

    <div class="venue-card">

        <!-- Page Header -->
        <div class="venue-header">

            <h1>
                <i class="bi bi-building venue-header-icon"></i>
                Create New Venue
            </h1>

            <p>
                Add a venue to your EventEase venue collection.
            </p>

        </div>


        <!-- Form -->
        <div class="venue-form">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary">
                </div>


                <!-- Venue Information -->
                <div class="section-title">
                    <i class="bi bi-info-circle me-2"></i>
                    Venue Information
                </div>


                <!-- Venue Name -->
                <div class="mb-4">

                    <label asp-for="VenueName"
                           class="form-label">

                        <i class="bi bi-building"></i>
                        Venue Name

                    </label>

                    <input asp-for="VenueName"
                           class="form-control"
                           placeholder="Enter venue name" />

                    <span asp-validation-for="VenueName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Location -->
                <div class="mb-4">

                    <label asp-for="Location"
                           class="form-label">

                        <i class="bi bi-geo-alt"></i>
                        Location

                    </label>

                    <input asp-for="Location"
                           class="form-control"
                           placeholder="Enter venue location" />

                    <span asp-validation-for="Location"
                          class="text-danger">
                    </span>

                </div>


                <!-- Capacity and Hourly Rate -->
                <div class="row">

                    <!-- Capacity -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Capacity"
                               class="form-label">

                            <i class="bi bi-people"></i>
                            Capacity

                        </label>

                        <input asp-for="Capacity"
                               class="form-control"
                               placeholder="Enter maximum capacity" />

                        <span asp-validation-for="Capacity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Hourly Rate -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="HourlyRate"
                               class="form-label">

                            <i class="bi bi-currency-exchange"></i>
                            Hourly Rate

                        </label>

                        <input asp-for="HourlyRate"
                               class="form-control"
                               placeholder="Enter hourly rate" />

                        <span asp-validation-for="HourlyRate"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Venue Image Section -->
                <div class="section-title mt-2">

                    <i class="bi bi-image me-2"></i>
                    Venue Image

                </div>


                <div class="image-section">

                    <div class="image-icon">

                        <i class="bi bi-cloud-arrow-up"></i>

                    </div>

                    <h5>
                        Upload Venue Image
                    </h5>

                    <p>
                        Add a clear image of the venue for display in EventEase.
                        JPEG, PNG, GIF or WebP. Maximum size: 5 MB.
                    </p>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.gif,.webp" />

                    <span class="field-help">
                        The selected image will be stored using Azure Blob Storage.
                    </span>

                </div>


                <!-- Buttons -->
                <div class="button-section">

                    <a asp-action="Index"
                       class="btn btn-cancel">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-create">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Venue

                    </button>

                </div>


                <!-- Required Information Note -->
                <div class="required-note">

                    <i class="bi bi-info-circle me-1"></i>

                    Please complete all required venue information before
                    creating the venue.

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}